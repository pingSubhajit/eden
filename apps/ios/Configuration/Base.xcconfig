// Eden for iPhone and iPad. One identity for both: the Mac app has the same
// bundle id, so Handoff and iCloud are one app's on every device.
EDEN_BUNDLE_IDENTIFIER = com.subhajit.eden.beta
// Techaboard Digi Solutions Private Limited, as Mulberry and the Mac app.
DEVELOPMENT_TEAM = HMJX9736KN
CODE_SIGN_STYLE = Automatic
// The iCloud container the tabs and pins sync through (Phase 4). Xcode
// registers it with the App ID under automatic signing.
EDEN_ICLOUD_CONTAINER = iCloud.$(EDEN_BUNDLE_IDENTIFIER)
// The Handoff activity of a page in Eden, beside the system's own
// NSUserActivityTypeBrowsingWeb; the Mac app declares the same one.
EDEN_ACTIVITY_BROWSING = $(EDEN_BUNDLE_IDENTIFIER).browsing
#include? "Local.xcconfig"
