<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime refuses the camera and the microphone unless the
       app says up front that pages may ask for them. -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Likewise for a page asking where you are, which Eden puts to you
       first, site by site (see Browser.askedForLocation). -->
  <key>com.apple.security.personal-information.location</key><true/>
  <!-- Your own card in Contacts, for filling in forms (MeCard.swift), once
       you turn it on. -->
  <key>com.apple.security.personal-information.addressbook</key><true/>
  <!-- Sync through iCloud (Sync.swift): Eden's CloudKit container, the same
       one the iPhone and iPad app uses, and the silent push that says
       another device changed something. Only with the matching development
       provisioning profile embedded, which build.sh does when
       Eden.development.provisionprofile is next to it; the two identifiers
       tie the app to that profile. -->
  <key>com.apple.application-identifier</key><string>HMJX9736KN.com.subhajit.eden.beta</string>
  <key>com.apple.developer.team-identifier</key><string>HMJX9736KN</string>
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array><string>iCloud.com.subhajit.eden.beta</string></array>
  <key>com.apple.developer.icloud-services</key>
  <array><string>CloudKit</string></array>
  <key>com.apple.developer.aps-environment</key><string>development</string>
</dict>
</plist>
